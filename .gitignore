# Terraform and Terragrunt working directories
**/.terraform/
**/.terragrunt-cache/
**/.terragrunt-stack/

# Lock files that `terraform init` creates in a module (tests): the only lock
# file is the root one
modules/*/.terraform.lock.hcl

# Local state, plans and crash logs: never commit them
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Python
__pycache__/
