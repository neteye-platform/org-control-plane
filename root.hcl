# Root Terragrunt configuration, included by every unit.
#
# The only prerequisite is an AWS session (for example `aws sso login`). The
# state lives in S3, and the GitHub App credentials and the billing email are
# read from SSM Parameter Store under `local.ssm_prefix`. See the README.

locals {
  github_org     = "neteye-platform"
  aws_region     = "eu-south-1"
  tfstate_bucket = "${local.aws_region}-${local.github_org}-tfstate"
  ssm_prefix     = "/org-control-plane"

  # All parameters under the prefix, read with a single AWS CLI call and cached
  # for the whole Terragrunt run. Keys are the names without the prefix, for
  # example "github-app/private-key". The values never appear in the logs.
  ssm_parameters = {
    for p in jsondecode(run_cmd(
      "--terragrunt-quiet", "--terragrunt-global-cache",
      "aws", "ssm", "get-parameters-by-path",
      "--region", local.aws_region,
      "--path", local.ssm_prefix,
      "--recursive",
      "--with-decryption",
      "--query", "Parameters[].[Name,Value]",
      "--output", "json",
    )) : trimprefix(p[0], "${local.ssm_prefix}/") => p[1]
  }
}

remote_state {
  backend = "s3"

  generate = {
    path      = "backend.tf"
    if_exists = "overwrite_terragrunt"
  }

  config = {
    bucket = local.tfstate_bucket
    # Units generated by a stack live in `.terragrunt-stack/`: drop that part so
    # that the state key only depends on the source directory, for example
    # `repositories/ai/terraform.tfstate`.
    key          = "${replace(path_relative_to_include(), ".terragrunt-stack/", "")}/terraform.tfstate"
    region       = local.aws_region
    encrypt      = true
    use_lockfile = true
  }
}

generate "provider" {
  path      = "provider.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<-EOF
    provider "github" {
      owner = "${local.github_org}"

      # Credentials come from the GITHUB_APP_* environment variables set below.
      app_auth {}

      retryable_errors = [429, 500, 502, 503, 504]
    }
  EOF
}

# A single provider lock file for every unit, kept up to date by Renovate.
generate "lock_file" {
  path      = ".terraform.lock.hcl"
  if_exists = "overwrite"
  contents  = file("${get_repo_root()}/.terraform.lock.hcl")
}

terraform {
  # The lock file is generated from the root one: never copy it back into the unit.
  copy_terraform_lock_file = false

  extra_arguments "lock_file_readonly" {
    commands  = ["init"]
    arguments = ["-lockfile=readonly"]
  }

  extra_arguments "retry_lock" {
    commands  = get_terraform_commands_that_need_locking()
    arguments = ["-lock-timeout=20m"]
  }

  # Set as environment variables of the Terraform process only, never written to disk.
  extra_arguments "github_app_credentials" {
    commands = get_terraform_commands_that_need_vars()
    env_vars = {
      GITHUB_APP_ID              = local.ssm_parameters["github-app/app-id"]
      GITHUB_APP_INSTALLATION_ID = local.ssm_parameters["github-app/installation-id"]
      GITHUB_APP_PEM_FILE        = local.ssm_parameters["github-app/private-key"]
    }
  }
}
