# Template of a repository category unit, generated by
# repositories/terragrunt.stack.hcl. `values.category` is the directory name.

include "root" {
  path   = find_in_parent_folders("root.hcl")
  expose = true
}

terraform {
  source = "${get_repo_root()}//modules/github-repositories"
}

# Teams are applied first, because repositories grant them access.
dependencies {
  paths = ["${get_repo_root()}/teams"]
}

locals {
  root_dir     = "${get_repo_root()}/repositories"
  category_dir = "${local.root_dir}/${values.category}"

  # Files whose name starts with "_" hold defaults, every other file is a
  # repository. A category without defaults has `{}` in its _defaults.yaml.
  repository_files = [for f in fileset(local.category_dir, "*.yaml") : f if !startswith(f, "_")]
}

inputs = {
  settings = {
    defaults = {
      org      = yamldecode(file("${local.root_dir}/_defaults.yaml"))
      category = yamldecode(file("${local.category_dir}/_defaults.yaml"))
    }
    repositories = {
      for f in local.repository_files :
      trimsuffix(f, ".yaml") => yamldecode(file("${local.category_dir}/${f}"))
    }
  }
}
